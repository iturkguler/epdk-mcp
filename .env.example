# Mistral OCR (opsiyonel) — taranmış PDF'lerden metin çıkarımı için
# https://console.mistral.ai/api-keys/ adresinden alabilirsiniz
# MISTRAL_API_KEY=your-key-here

# Log seviyesi (varsayılan: INFO)
# LOG_LEVEL=DEBUG

# EPDK istekleri arasındaki gecikme (saniye, varsayılan: 1.5)
# EPDK_DELAY_SECONDS=2.0
